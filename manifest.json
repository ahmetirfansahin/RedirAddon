{
  "manifest_version": 3,
  "name": "RedirAddon",
  "version": "1.0.0",
  "description": "Chrome Web Store eklentilerini Firefox Add-ons (AMO) üzerinde tek tıkla bulur ve yönlendirir.",
  "author": "RedirAddon Team",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RedirAddon - Firefox Eklenti Yönlendirici",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://chromewebstore.google.com/*",
    "https://addons.mozilla.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chromewebstore.google.com/detail/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ]
}

